# Adresses des services — jamais de secret dans ce fichier, seulement des noms
ATLAS_CORE_URL=ws://neo.local:8080/ws/audio
ATLAS_STT_URL=http://unraid.local:9010
ATLAS_TTS_URL=http://unraid.local:9011

# Moteur TTS : valeur décidée par le spike S1 (qwen3 | piper | kokoro)
ATLAS_TTS_MOTEUR=piper
ATLAS_TTS_VOIX=fr_FR-siwis-medium

# Modèle de transcription
ATLAS_STT_MODELE=large-v3
ATLAS_STT_DECHARGEMENT_S=300

# Seuils réglables du client audio — valeurs par défaut, à ajuster avec le banc de mesure (bench/, tâche 14)
# Seuil du mot de réveil : plus haut réduit les faux réveils, plus bas réduit les réveils manqués.
ATLAS_REVEIL_SEUIL=0.5
# Durée de silence qui marque la fin d'une phrase dite à Atlas.
ATLAS_SILENCE_MS=400
# Durée de parole minimale pour couper Atlas quand il parle (barge-in).
ATLAS_BARGEIN_MS=300

# Client audio (MacBook) — chemins et choix de composants
# Déclencheur du réveil : « touche » (Entrée au clavier) ou « motcle » (openWakeWord).
ATLAS_REVEILLEUR=touche
# Modèle du mot de réveil entraîné (voir scripts/entrainer_mot_reveil.md).
ATLAS_MOT_REVEIL=models/hey_atlas.onnx
# Périphérique audio : « aec » (binaire Swift avec annulation d'écho) ou « sounddevice ».
ATLAS_AUDIO_PERIPHERIQUE=aec
# Binaire Swift d'annulation d'écho, construit par swift build -c release.
ATLAS_AEC_BINAIRE=src/atlas_aec/.build/release/atlas-aec
# Modèle Silero de détection de voix (voir bench/LISEZMOI.md pour le télécharger).
ATLAS_VAD_MODELE=models/silero_vad.onnx
